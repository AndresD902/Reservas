{
  "name": "Sistema de Reservas (Java 21 + PostgreSQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/Reservas",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "API de reservas",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "DB_USERNAME": "postgres",
    "DB_PASSWORD": "postgres",
    "TEST_DB_URL": "jdbc:postgresql://db:5432/sistema_reservas_test"
  },
  "postCreateCommand": "chmod +x gradlew && ./gradlew testClasses",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic"
      }
    }
  }
}
